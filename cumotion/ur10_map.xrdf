# ur10.xrdf with the WORLD collision buffer widened 0.02 -> 0.04 m on the links
# that sweep through the cell (forearm, wrists, tool) for planning against the
# handheld cell map (cumotion/start_cumotion_map.sh). The extra 2 cm absorbs
# the map's own error budget (2 cm voxels + cuVSLAM drift + tag anchor, each
# ~1 cm) so a plan that clears the ESDF also clears the real shelf.
# shoulder_link and upper_arm_link stay at 0.02: the upper arm's root sphere
# (r 0.09) sits only 3.8 cm above the mounting plane, i.e. 1.8 cm clear of
# cuMotion's ground plane at 0.02 — at 0.04 it is INSIDE the ground plane and
# every start state fails with INVALID_INITIAL_CSPACE_POSITION (found in the
# synthetic rehearsal, 2026-08-26). Those two links never leave the base
# region anyway. Self-collision buffers unchanged. ur10.xrdf stays the default
# for the ground-plane-only planner.
format: xrdf
format_version: 1.0

modifiers:
  - set_base_frame: "base_link"

default_joint_positions:
  shoulder_pan_joint: 0.0
  shoulder_lift_joint: -2.2
  elbow_joint: 1.9
  wrist_1_joint: -1.383
  wrist_2_joint: -1.57
  wrist_3_joint: 0.0

cspace:
  joint_names:
    - "shoulder_pan_joint"
    - "shoulder_lift_joint"
    - "elbow_joint"
    - "wrist_1_joint"
    - "wrist_2_joint"
    - "wrist_3_joint"
  acceleration_limits: [12.0, 12.0, 12.0, 12.0, 12.0, 12.0]
  jerk_limits: [500.0, 500.0, 500.0, 500.0, 500.0, 500.0]

tool_frames: ["tool0"]

collision:
  geometry: "ur10e_collision_spheres"
  buffer_distance:
    shoulder_link: 0.02
    upper_arm_link: 0.02
    forearm_link: 0.04
    wrist_1_link: 0.04
    wrist_2_link: 0.04
    wrist_3_link: 0.04
    tool0: 0.04

self_collision:
  geometry: "ur10e_collision_spheres"
  buffer_distance:
    shoulder_link: 0.07
    tool0: 0.05
  ignore:
    upper_arm_link: ["forearm_link", "shoulder_link"]
    forearm_link: ["wrist_1_link"]
    wrist_1_link: ["wrist_2_link","wrist_3_link"]
    wrist_2_link: ["wrist_3_link", "tool0"]
    wrist_3_link: ["tool0"]

geometry:
  ur10e_collision_spheres:
    spheres:
      shoulder_link:
        - center: [0, 0, 0]
          radius: 0.05
      upper_arm_link:
        - center: [-0, -0, 0.18]
          radius: 0.09
        - center: [-0.102167, 0,  0.18]
          radius: 0.05
        - center: [-0.204333, 0, 0.18]
          radius: 0.05
        - center: [-0.3065, 0, 0.18]
          radius: 0.05
        - center: [-0.408667, 0, 0.18]
          radius: 0.05
        - center: [-0.510833, 0, 0.18]
          radius: 0.05
        - center: [-0.613, 0,0.18]
          radius: 0.07
      forearm_link:
        - center: [-0, 0, 0.03]
          radius: 0.05
        - center: [-0.0951667, 0, 0.03]
          radius: 0.05
        - center: [-0.190333, 0, 0.03]
          radius: 0.05
        - center: [-0.2855, 0, 0.03]
          radius: 0.05
        - center: [-0.380667, 0,0.03]
          radius: 0.05
        - center: [-0.475833, 0,0.03]
          radius: 0.05
        - center: [-0.571, -1.19904e-17, 0.03]
          radius: 0.05
      wrist_1_link:
        - center: [0, 0, 0]
          radius: 0.05
      wrist_2_link:
        - center: [0, 0, 0]
          radius: 0.05
      wrist_3_link:
        - center: [0, 0, 0]
          radius: 0.05
        - center: [0, 0, 0.06]
          radius: 0.07
      tool0:
        - center: [0, 0, 0.12]
          radius: 0.01 # NOTE: this is updated from -0.01 to 0.01 as negative radius is not
                       # supported in cuMotion.

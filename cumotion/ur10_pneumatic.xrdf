# GENERATED 2026-08-28T17:07:19 by make_limited_urdf.py from ur10_map.xrdf.
# - default_joint_positions moved to the pneumatic reference pose
#   (the stock retract config is outside the windows and cuMotion
#   rejects it as an invalid RobotDescription).
# - shoulder_link, upper_arm_link excluded from WORLD collision only,
#   via the generated "ur10e_collision_spheres_world_only" sphere set: the map contains the
#   robot's own mounting pedestal. SELF-collision still uses the full
#   set, so the arm is checked against itself everywhere.
# Do not edit by hand.
format: xrdf
format_version: 1.0
modifiers:
- {set_base_frame: base_link}
default_joint_positions: {shoulder_pan_joint: -4.3076, shoulder_lift_joint: -1.3338,
  elbow_joint: 1.5676, wrist_1_joint: 2.9386, wrist_2_joint: 4.367, wrist_3_joint: -1.5911}
cspace:
  joint_names: [shoulder_pan_joint, shoulder_lift_joint, elbow_joint, wrist_1_joint,
    wrist_2_joint, wrist_3_joint]
  acceleration_limits: [12.0, 12.0, 12.0, 12.0, 12.0, 12.0]
  jerk_limits: [500.0, 500.0, 500.0, 500.0, 500.0, 500.0]
tool_frames: [tool0]
collision:
  geometry: ur10e_collision_spheres_world_only
  buffer_distance: {forearm_link: 0.04, wrist_1_link: 0.04, wrist_2_link: 0.04, wrist_3_link: 0.04,
    tool0: 0.04}
self_collision:
  geometry: ur10e_collision_spheres
  buffer_distance: {shoulder_link: 0.07, tool0: 0.05}
  ignore:
    upper_arm_link: [forearm_link, shoulder_link]
    forearm_link: [wrist_1_link]
    wrist_1_link: [wrist_2_link, wrist_3_link]
    wrist_2_link: [wrist_3_link, tool0]
    wrist_3_link: [tool0]

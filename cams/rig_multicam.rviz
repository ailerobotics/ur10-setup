# RViz view for the three-camera rig (rig_multicam.launch.py), Step 1.
# The three RGB Image displays need no TF, so all three feeds show immediately
# even before extrinsics exist. Depth + pointclouds also present; pointclouds
# render once each camera's extrinsic TF is published (Step 2 calibration).
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Tree Height: 640
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 12
      Reference Frame: world
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.5
      Frame Timeout: 9999
    # ---- RGB feeds (the Step-1 deliverable: all three visible at once) ----
    - Class: rviz_default_plugins/Image
      Name: WRIST rgb
      Enabled: true
      Topic:
        Value: /wrist/color/image_raw
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Normalize Range: true
    - Class: rviz_default_plugins/Image
      Name: SHELF rgb
      Enabled: true
      Topic:
        Value: /shelf/color/image_raw
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Normalize Range: true
    - Class: rviz_default_plugins/Image
      Name: TABLE rgb
      Enabled: true
      Topic:
        Value: /table/color/image_raw
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Normalize Range: true
    # ---- Aligned depth (metres, normalized for visibility) ----
    - Class: rviz_default_plugins/Image
      Name: WRIST depth
      Enabled: false
      Topic:
        Value: /wrist/aligned_depth/image
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Normalize Range: true
    - Class: rviz_default_plugins/Image
      Name: SHELF depth
      Enabled: false
      Topic:
        Value: /shelf/aligned_depth/image
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Normalize Range: true
    - Class: rviz_default_plugins/Image
      Name: TABLE depth
      Enabled: false
      Topic:
        Value: /table/aligned_depth/image
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Normalize Range: true
    # ---- Coloured pointclouds (render after Step-2 extrinsics land) ----
    - Class: rviz_default_plugins/PointCloud2
      Name: WRIST cloud
      Enabled: true
      Topic:
        Value: /wrist/points
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 2
      Color Transformer: RGB8
      Position Transformer: XYZ
      Decay Time: 0
    - Class: rviz_default_plugins/PointCloud2
      Name: SHELF cloud
      Enabled: true
      Topic:
        Value: /shelf/points
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 2
      Color Transformer: RGB8
      Position Transformer: XYZ
      Decay Time: 0
    - Class: rviz_default_plugins/PointCloud2
      Name: TABLE cloud
      Enabled: true
      Topic:
        Value: /table/points
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 2
      Color Transformer: RGB8
      Position Transformer: XYZ
      Decay Time: 0
  Global Options:
    Background Color: 33; 33; 38
    Fixed Frame: world
    Frame Rate: 30
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 4.5
      Focal Point:
        X: 0.0
        Y: -0.9
        Z: 0.8
      Pitch: 0.35
      Yaw: 3.6
    Saved: ~
Window Geometry:
  Height: 1000
  Width: 1700

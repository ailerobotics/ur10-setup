# Harness outputs live under the task tmp dir / ~/.cache, never in git. These
# rules only catch anything accidentally written into the source tree.
__pycache__/
*.pyc
.pytest_cache/
out/
runs/
*.jsonl
*.png
# recorded/composed video artefacts (belong under ~/.cache or firstmate/data)
*.jpg
*.jpeg
*.mp4
*.html
!tests/data/*.png
# committed regression fixtures (an intentional recorded artifact, not run output)
!tests/data/**/*.jsonl
